// use prisma-8

model User {
  id           String            @id @default(uuid())
  name         String            @unique
  hash         String
  messages     Message[]
  createdAt    TimestamptzString @default(now())
  ownedServers Server[]          @relation("ServerOwners")
  servers      Server[]          @relation("serverMembers")
}

model Server {
  id       String    @id @default(uuid())
  owner    User      @relation("ServerOwners", fields: [ownerId], references: [id])
  name     String
  ownerId  String
  members  User[]    @relation("serverMembers")
  messages Message[]
}

model ServerMembers {
  server   Server @relation("serverMembers", fields: [serverId], references: [id])
  user     User   @relation("serverMembers", fields: [userId], references: [id])
  serverId String
  userId   String

  @@id([serverId, userId])
}

model Message {
  id        String            @id @default(uuid())
  content   String
  author    User              @relation(fields: [authorId], references: [id])
  authorId  String
  server    Server            @relation(fields: [serverId], references: [id])
  serverId  String
  createdAt TimestamptzString @default(now())
}

model Session {
  id        String            @id
  sid       String            @unique
  data      String // MediumText may be needed for MySql
  expiresAt TimestamptzString
}
